# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys. Used by @erp/web (anon), @erp/api (service role), and
# @erp/database tooling. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js public-side (mirrors the above for the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── SMS provider (@erp/api worker) ──────────────────────────────────────────
# Master kill switch for ALL outbound SMS — the daily cron AND both
# /internal/dispatch/* endpoints. Defaults to OFF: dispatch runs only when this
# is exactly "true". Leave it unset until a real provider is configured,
# because consume_sms_credit runs BEFORE provider.send and is not refunded on
# a transport failure — an unconfigured worker would burn credit per reminder.
SMS_DISPATCH_ENABLED=false

# Single swappable adapter selected by SMS_PROVIDER (e.g. "generic_http").
SMS_PROVIDER=generic_http
SMS_PROVIDER_BASE_URL=https://sms-provider.example.com
SMS_PROVIDER_API_KEY=your-provider-api-key

# Verifies inbound delivery webhooks from the provider.
SMS_WEBHOOK_SECRET=your-webhook-secret

# Protects internal dispatch endpoints (cron -> worker). Read by
# packages/api/src/middleware/internal-auth.ts as INTERNAL_DISPATCH_TOKEN —
# the name must match exactly (a stale "DISPATCH_INTERNAL_TOKEN" here was
# never actually read anywhere and silently did nothing).
INTERNAL_DISPATCH_TOKEN=your-internal-dispatch-token

# ── Localization / time (Article VIII) ──────────────────────────────────────
# Store UTC; compute/render in the school timezone.
SCHOOL_TZ=Africa/Khartoum

# ── Internal dispatch (web -> worker, dev/test) ─────────────────────────────
# @erp/web's server actions call @erp/api's dispatch endpoints at this URL
# (packages/web/lib/actions/reminders.ts). Must match the port @erp/api
# actually listens on (default 8080, see packages/api/src/index.ts PORT).
WORKER_URL=http://localhost:8080
