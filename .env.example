# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys. Used by @erp/web (anon), @erp/api (service role), and
# @erp/database tooling. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js public-side (mirrors the above for the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── SMS provider (@erp/api worker) ──────────────────────────────────────────
# Single swappable adapter selected by SMS_PROVIDER (e.g. "generic_http").
SMS_PROVIDER=generic_http
SMS_PROVIDER_BASE_URL=https://sms-provider.example.com
SMS_PROVIDER_API_KEY=your-provider-api-key

# Verifies inbound delivery webhooks from the provider.
SMS_WEBHOOK_SECRET=your-webhook-secret

# Protects internal dispatch endpoints (cron -> worker).
DISPATCH_INTERNAL_TOKEN=your-internal-dispatch-token

# ── Localization / time (Article VIII) ──────────────────────────────────────
# Store UTC; compute/render in the school timezone.
SCHOOL_TZ=Africa/Khartoum
